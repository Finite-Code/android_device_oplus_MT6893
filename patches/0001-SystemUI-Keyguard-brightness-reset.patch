Subject: [PATCH] SystemUI: Keyguard brightness reset

---
 .../biometrics/AuthContainerView.java         | 27 +++++++++++
 .../systemui/biometrics/UdfpsController.java  | 45 +++++++++++++++++++
 .../keyguard/KeyguardViewMediator.java        | 22 +++++++++
 3 files changed, 94 insertions(+)

diff --git a/frameworks/base/packages/SystemUI/src/com/android/systemui/biometrics/AuthContainerView.java b/frameworks/base/packages/SystemUI/src/com/android/systemui/biometrics/AuthContainerView.java
index f2e2a2a1a976..ddb0c1acb742 100644
--- a/frameworks/base/packages/SystemUI/src/com/android/systemui/biometrics/AuthContainerView.java
+++ b/frameworks/base/packages/SystemUI/src/com/android/systemui/biometrics/AuthContainerView.java
@@ -91,6 +91,13 @@ import java.util.Set;
 
 import javax.inject.Provider;
 
+import com.android.systemui.util.settings.SystemSettings;
+import android.provider.Settings;
+import android.content.ContentResolver;
+import android.provider.Settings.SettingNotFoundException;
+import android.os.Handler;
+import android.os.Looper;
+
 /**
  * Top level container/controller for the BiometricPrompt UI.
  *
@@ -691,6 +698,26 @@ public class AuthContainerView extends LinearLayout
                     .withEndAction(endActionRunnable)
                     .start();
         });
+        pokeBrightnessDelayed(mContext, 2000);
+    }
+
+    public void pokeBrightnessDelayed(Context context, long delayMs) {
+        new Handler(Looper.getMainLooper()).postDelayed(() -> {
+           pokeBrightness(context);
+       }, delayMs);
+    }
+
+    public void pokeBrightness(Context context) {
+        ContentResolver cr = context.getContentResolver();
+        try {
+            int cur = Settings.System.getInt(cr, Settings.System.SCREEN_BRIGHTNESS);
+            int tmp = (cur + 2) % 256;
+            Settings.System.putInt(cr, Settings.System.SCREEN_BRIGHTNESS, tmp);
+            Settings.System.putInt(cr, Settings.System.SCREEN_BRIGHTNESS, cur);
+            Log.i(TAG, "Brightness poke done: original=" + cur + " temporary=" + tmp);
+        } catch (Settings.SettingNotFoundException e) {
+            Log.w(TAG, "Failed to read/write screen_brightness", e);
+        }
     }
 
     private void sendPendingCallbackIfNotNull() {
