cc_library_static {
    name: "libinit_MT6893",
    recovery_available: true,
    whole_static_libs: ["libbase"],
    header_libs: [
        "libbase_headers",
    ],
    srcs: ["init_MT6893.cpp"],
    include_dirs: [
        "system/core/init"
    ]
}

cc_binary {
    name: "init_MT6893_vendor",
    srcs: ["init_MT6893_vendor.cpp"],
    shared_libs: ["libbase"],
    init_rc: ["init_MT6893_vendor.rc"],
    vendor: true,
}
